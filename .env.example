# ==============================================================================
# CONFIGURACOES DO AMBIENTE VISALYTICA
# ==============================================================================

# BANCO DE DADOS POSTGRESQL LOCAL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=visalytica
POSTGRES_PORT=5432
DB_SSL=false

# BACKEND (NESTJS)
JWT_SECRET=visalytica_super_secret_jwt_key_2026
JWT_EXPIRATION=7d

# AWS S3 (OPCIONAL/MOCK PARA DESENVOLVIMENTO)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=dummy_access_key
AWS_SECRET_ACCESS_KEY=dummy_secret_key
AWS_S3_BUCKET_NAME=visalytica-bucket

# VISAO COMPUTACIONAL
VISION_MODEL_PATH=my_model.pt

# FRONTEND
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_VISION_URL=http://localhost:5000
